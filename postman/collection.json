{
  "info": {
    "name": "Customer Platform API",
    "description": "Functional and regression checks. Run with `npm run test:postman` (mints fresh tokens into environment.local.json first). Requests run in order: the Setup folder resets the mock upstreams so the run is repeatable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Reset mock upstreams",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reset ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{mocksUrl}}/__reset"
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ready', () => pm.expect(pm.response.json().status).to.be.oneOf(['ok','degraded']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "Functional",
      "item": [
        {
          "name": "Customer (support scope, ARR redacted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('aggregate shape', () => { pm.expect(b.supportTier).to.eql('Platinum'); pm.expect(b.contract.renewalDate).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(b).to.have.property('usage'); });",
                  "pm.test('ARR redacted', () => { pm.expect(b).to.not.have.property('arrUsd'); pm.expect(b.redactedFields).to.include('arrUsd'); });",
                  "pm.test('rate limit headers', () => pm.expect(pm.response.headers.has('RateLimit-Remaining')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_support}}"
              }
            ],
            "url": "{{baseUrl}}/v1/customers/ACC-007"
          }
        },
        {
          "name": "Customer (finance scope, ARR visible)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ARR present', () => pm.expect(pm.response.json().arrUsd).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_finance}}"
              }
            ],
            "url": "{{baseUrl}}/v1/customers/ACC-007"
          }
        },
        {
          "name": "Cases: sample question",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('openedBefore', new Date(Date.now() - 48*3600e3).toISOString());",
                  "pm.collectionVariables.set('renewalBefore', new Date(Date.now() + 90*864e5).toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().data.map(c => c.id).sort();",
                  "pm.test('expected three cases', () => pm.expect(ids).to.eql(['CS-10231','CS-10232','CS-10233']));",
                  "pm.test('account embedded', () => pm.response.json().data.forEach(c => pm.expect(c.account.supportTier).to.eql('Platinum')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_support}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases?status=open,pending,escalated&priority=P1&supportTier=Platinum&openedBefore={{openedBefore}}&renewalBefore={{renewalBefore}}&include=account"
          }
        },
        {
          "name": "Cases: page 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('5 items + cursor', () => { pm.expect(b.data.length).to.eql(5); pm.expect(b.page.nextCursor).to.be.a('string'); });",
                  "pm.collectionVariables.set('cursor', b.page.nextCursor);",
                  "pm.collectionVariables.set('page1Ids', JSON.stringify(b.data.map(c => c.id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_support}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases?limit=5&sort=priority"
          }
        },
        {
          "name": "Cases: page 2 via cursor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = pm.response.json().data.map(c => c.id);",
                  "const prev = JSON.parse(pm.collectionVariables.get('page1Ids'));",
                  "pm.test('no overlap with page 1', () => ids.forEach(id => pm.expect(prev).to.not.include(id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_support}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases?limit=5&sort=priority&cursor={{cursor}}"
          }
        },
        {
          "name": "Case: get + ETag",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with ETag', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('ETag')).to.match(/^\"[a-f0-9]+\"$/); });",
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lead}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases/CS-10231"
          }
        },
        {
          "name": "Comment: create",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idemKey', 'pm-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('author is token subject', () => pm.expect(pm.response.json().author).to.eql('alice'));",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include('/v1/cases/CS-10231/comments/'));",
                  "pm.collectionVariables.set('commentId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_support}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases/CS-10231/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Agent on node 3 upgraded, monitoring tonight's run.\"\n}"
            }
          }
        },
        {
          "name": "Comment: replay same key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replayed, same id', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('commentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_support}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases/CS-10231/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Agent on node 3 upgraded, monitoring tonight's run.\"\n}"
            }
          }
        },
        {
          "name": "Case: refresh ETag after comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lead}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases/CS-10231"
          }
        },
        {
          "name": "Escalate: success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 escalated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('escalated'); });",
                  "pm.test('new ETag', () => pm.expect(pm.response.headers.get('ETag')).to.not.eql(pm.collectionVariables.get('etag')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lead}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "{{etag}}"
              }
            ],
            "url": "{{baseUrl}}/v1/cases/CS-10231/escalate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"renewal_risk\",\n  \"note\": \"Backups failing 4 days, renews in January\"\n}"
            }
          }
        },
        {
          "name": "Webhook: consumer received signed event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const events = pm.response.json();",
                  "pm.test('case.escalated delivered', () => pm.expect(events.some(e => e.type === 'case.escalated' && e.data.caseId === 'CS-10231')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mocksUrl}}/consumer/webhooks/received"
          }
        }
      ]
    },
    {
      "name": "Regression: errors",
      "item": [
        {
          "name": "401 without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('problem+json body', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.type).to.include('unauthorized');",
                  "  pm.expect(b.status).to.eql(401);",
                  "  pm.expect(b.correlationId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/cases"
          }
        },
        {
          "name": "403 escalate without scope",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
