# All optional; defaults work for local dev.
PORT=3000
LOG_LEVEL=info
DB_PATH=var/platform.db

# Auth. Local dev signs HS256 tokens with this secret (scripts/token.js).
# Anywhere real: unset JWT_HS_SECRET and set JWKS_URL to the IdP's keys.
JWT_ISSUER=https://idp.local.test/
JWT_AUDIENCE=customer-platform-api
JWT_HS_SECRET=local-dev-only-secret-change-me-0123456789
# JWKS_URL=https://idp.example.com/.well-known/jwks.json

# Mock upstreams
EMBED_MOCKS=true
MOCKS_PORT=4010
FIXTURE_TIME_SHIFT=true

# Upstream URLs (default to the embedded mocks)
# CASES_URL=http://127.0.0.1:4010/crm
# ENTITLEMENTS_URL=http://127.0.0.1:4010/erp
# USAGE_URL=http://127.0.0.1:4010/warehouse

# Resilience
BREAKER_FAILURES=5
BREAKER_COOLDOWN_MS=10000
ENTITLEMENT_CACHE_TTL_MS=60000

# Webhooks: private targets are only allowed for local dev
WEBHOOK_ALLOW_PRIVATE=true

# MCP server
# PLATFORM_TOKEN=<delegated token: make token P=copilot>
# PLATFORM_API_URL=http://localhost:3000
# MCP_APPROVAL_MODE=elicit   # elicit | preview | deny

# Demo / evals
# ANTHROPIC_API_KEY=...
# DEMO_MODEL=claude-opus-5-5
